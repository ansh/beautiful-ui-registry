{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "beautiful-ui",
  "homepage": "https://www.beautifului.dev",
  "items": [
    {
      "name": "theme",
      "type": "registry:style",
      "title": "Beautiful UI theme",
      "description": "Design tokens for Beautiful UI — surfaces, ink ramp, hairlines, semantic colours, radii, easings and the layered elevation scale, in light and dark.",
      "files": [
        {
          "path": "registry/beautiful-ui/theme/beautiful-ui.css",
          "type": "registry:file",
          "target": "styles/beautiful-ui.css"
        }
      ]
    },
    {
      "name": "loading-state",
      "type": "registry:ui",
      "title": "Loading State",
      "description": "Pixel-grid loader with shimmer and elapsed time.",
      "dependencies": ["clsx", "tailwind-merge"],
      "registryDependencies": ["theme"],
      "files": [
        {
          "path": "registry/beautiful-ui/ui/loading-state.tsx",
          "type": "registry:ui",
          "target": "components/beautiful-ui/loading-state.tsx"
        }
      ]
    },
